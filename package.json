{
  "name": "agent-config-guard",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.1",
  "publisher": "NNNCODE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NNNCODE/agent-config-guard.git"
  },
  "bugs": {
    "url": "https://github.com/NNNCODE/agent-config-guard/issues"
  },
  "homepage": "https://github.com/NNNCODE/agent-config-guard#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p . --noEmit",
    "compile-tests": "tsc -p .",
    "test": "npm run build && npm run compile-tests && node --test --test-reporter=tap \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && npm run compile-tests && node out/test/integration/runTest.js",
    "package": "vsce package"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "typescript": "7.0.2"
  },
  "keywords": [
    "claude code",
    "codex",
    "cursor",
    "copilot",
    "opencode",
    "mcp",
    "hooks",
    "security"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentConfigGuard",
          "title": "%view.container%",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "agentConfigGuard": [
        {
          "id": "agentConfigGuard.changes",
          "name": "%view.changes%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentConfigGuard.changes",
        "contents": "%view.welcome%",
        "when": "agentConfigGuard.noBaseline"
      }
    ],
    "commands": [
      {
        "command": "agentConfigGuard.createBaseline",
        "title": "%cmd.createBaseline%",
        "category": "Agent Config Guard"
      },
      {
        "command": "agentConfigGuard.checkNow",
        "title": "%cmd.checkNow%",
        "category": "Agent Config Guard",
        "icon": "$(refresh)"
      },
      {
        "command": "agentConfigGuard.showDiff",
        "title": "%cmd.showDiff%",
        "category": "Agent Config Guard",
        "icon": "$(diff)"
      },
      {
        "command": "agentConfigGuard.accept",
        "title": "%cmd.accept%",
        "category": "Agent Config Guard",
        "icon": "$(check)"
      },
      {
        "command": "agentConfigGuard.revert",
        "title": "%cmd.revert%",
        "category": "Agent Config Guard",
        "icon": "$(discard)"
      },
      {
        "command": "agentConfigGuard.exportLog",
        "title": "%cmd.exportLog%",
        "category": "Agent Config Guard",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentConfigGuard.showDiff",
          "when": "false"
        },
        {
          "command": "agentConfigGuard.accept",
          "when": "false"
        },
        {
          "command": "agentConfigGuard.revert",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentConfigGuard.checkNow",
          "when": "view == agentConfigGuard.changes",
          "group": "navigation@1"
        },
        {
          "command": "agentConfigGuard.createBaseline",
          "when": "view == agentConfigGuard.changes",
          "group": "9_baseline"
        },
        {
          "command": "agentConfigGuard.exportLog",
          "when": "view == agentConfigGuard.changes",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agentConfigGuard.showDiff",
          "when": "view == agentConfigGuard.changes && viewItem == file.pending",
          "group": "inline@1"
        },
        {
          "command": "agentConfigGuard.accept",
          "when": "view == agentConfigGuard.changes && viewItem == file.pending",
          "group": "inline@2"
        },
        {
          "command": "agentConfigGuard.revert",
          "when": "view == agentConfigGuard.changes && viewItem == file.pending",
          "group": "inline@3"
        },
        {
          "command": "agentConfigGuard.showDiff",
          "when": "view == agentConfigGuard.changes && viewItem == file.pending",
          "group": "1_review@1"
        },
        {
          "command": "agentConfigGuard.accept",
          "when": "view == agentConfigGuard.changes && viewItem == file.pending",
          "group": "1_review@2"
        },
        {
          "command": "agentConfigGuard.revert",
          "when": "view == agentConfigGuard.changes && viewItem == file.pending",
          "group": "1_review@3"
        }
      ]
    },
    "configuration": {
      "title": "Agent Config Guard",
      "properties": {
        "agentConfigGuard.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "markdownDescription": "%config.pollIntervalSeconds%"
        },
        "agentConfigGuard.autoAcceptLowRisk": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.autoAcceptLowRisk%"
        }
      }
    }
  },
  "icon": "media/icon.png",
  "author": {
    "name": "MINGHUI NIE"
  }
}
