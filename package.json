{
  "name": "agent-config-guard",
  "displayName": "Agent Config Guard",
  "description": "Detects silent changes to coding-agent configs (Claude Code, Codex, Cursor, Copilot, OpenCode), flags risky ones, and lets you accept or revert them.",
  "version": "0.1.0",
  "publisher": "agent-config-guard",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p . --noEmit",
    "compile-tests": "tsc -p .",
    "test": "npm run compile-tests && node --test --test-reporter=tap \"out/test/unit/**/*.test.js\""
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.100.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
